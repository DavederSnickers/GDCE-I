+    def write_results_csv(self, exp_dict, num_dict):
+        """Write one row per explained graph, including the original and the
+        counterfactual SMILES (left empty when no valid molecule could be
+        formed)."""
+        results_path = getattr(self.args, 'results_path', 'results_mutag.csv')
+        if not os.path.isabs(results_path):
+            results_path = os.path.join(self.args.model_path, results_path)
+        rows = []
+        for gid, masked_adj in exp_dict.items():
+            graph = self.G_dataset.graphs[gid]
+            masked_adj = masked_adj.detach().cpu()
+            if self.fix_exp:
+                thresh = masked_adj.flatten().sort(descending=True)[0][self.fix_exp + 1]
+            else:
+                thresh = self.args.mask_thresh
+            exp_adj = (masked_adj > thresh).float()  # explanation edges
+            weight = graph.edata['weight'].cpu()
+            cf_present = (weight - exp_adj).numpy()  # counterfactual: edges minus explanation
+            smiles_original = mutag_graph_to_smiles(graph)
+            smiles_cf = mutag_graph_to_smiles(graph, edge_mask=cf_present)
+            rows.append({
+                'gid': int(gid),
+                'exp_num': num_dict[gid],
+                'smiles_original': smiles_original if smiles_original is not None else '',
+                'smiles_counterfactual': smiles_cf if smiles_cf is not None else '',
+            })
+        with open(results_path, 'w', newline='') as f:
+            writer = csv.DictWriter(
+                f, fieldnames=['gid', 'exp_num', 'smiles_original', 'smiles_counterfactual'])
+            writer.writeheader()
+            writer.writerows(rows)
+        formed = sum(1 for r in rows if r['smiles_original'])
+        print('results written to %s (%d rows, %d original SMILES formed)'
+              % (results_path, len(rows), formed))
+
