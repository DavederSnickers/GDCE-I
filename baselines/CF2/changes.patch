+def mutag_graph_to_smiles(dgl_G, edge_mask=None):
+    """Reconstruct a SMILES string from a Mutag molecule graph.
+
+    The Mutag preprocessing only keeps atom types and a plain adjacency, the
+    bond orders are lost. We therefore rebuild the molecule with single bonds
+    only and let RDKit fill the remaining valences with implicit hydrogens.
+
+    edge_mask: optional 1D array (same length / ordering as ``dgl_G.edata``)
+        selecting which edges are present. If None, all edges with weight > 0
+        are used (i.e. the original molecule).
+
+    Returns the canonical SMILES, or None if RDKit is unavailable or the
+    molecule cannot be sanitized (i.e. no valid molecule could be formed).
+    """
+    try:
+        from rdkit import Chem
+    except ImportError:
+        return None
+    component_dict = {0: 'C', 1: 'O', 2: 'Cl', 3: 'H', 4: 'N', 5: 'F', 6: 'Br', 7: 'S',
+                      8: 'P', 9: 'I', 10: 'Na', 11: 'K', 12: 'Li', 13: 'Ca'}
+    node_labels = dgl_G.ndata['feat'].numpy()
+    src = dgl_G.edges()[0].numpy()
+    dst = dgl_G.edges()[1].numpy()
+    weights = dgl_G.edata['weight'].numpy()
+    if edge_mask is None:
+        present = weights > 0
+    else:
+        present = np.asarray(edge_mask) > 0
+
+    mol = Chem.RWMol()
+    idx_map = {}
+    for n in range(node_labels.shape[0]):
+        sym = component_dict[int(np.argmax(node_labels[n]))]
+        idx_map[n] = mol.AddAtom(Chem.Atom(sym))
+    added = set()
+    for eid in range(len(src)):
+        if not present[eid]:
+            continue
+        a, b = int(src[eid]), int(dst[eid])
+        if a == b:
+            continue
+        key = (min(a, b), max(a, b))
+        if key in added:  # graph stores both directed edges, add bond once
+            continue
+        added.add(key)
+        mol.AddBond(idx_map[a], idx_map[b], Chem.BondType.SINGLE)
+    try:
+        m = mol.GetMol()
+        Chem.SanitizeMol(m)
+        return Chem.MolToSmiles(m)
+    except Exception:
+        return None
+
