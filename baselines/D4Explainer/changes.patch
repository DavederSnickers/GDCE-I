+def lookup_edge_attr(orig_edge_index, orig_edge_attr, new_edge_index):
+    """
+    For each edge in new_edge_index, look up its edge_attr from the original graph.
+    Edges not present in the original get zero features.
+
+    :param orig_edge_index: [2, E_orig]
+    :param orig_edge_attr:  [E_orig, F]
+    :param new_edge_index:  [2, E_new]
+    :return: [E_new, F]
+    """
+    feat_dim = orig_edge_attr.size(1) if orig_edge_attr.dim() > 1 else 1
+    edge_dict = {
+        (orig_edge_index[0, i].item(), orig_edge_index[1, i].item()): i
+        for i in range(orig_edge_index.size(1))
+    }
+    rows = []
+    for i in range(new_edge_index.size(1)):
+        key = (new_edge_index[0, i].item(), new_edge_index[1, i].item())
+        if key in edge_dict:
+            rows.append(orig_edge_attr[edge_dict[key]])
+        else:
+            rows.append(torch.zeros(feat_dim, device=orig_edge_attr.device))
+    if rows:
+        return torch.stack(rows)
+    return torch.zeros(0, feat_dim, device=orig_edge_attr.device)
+
+
