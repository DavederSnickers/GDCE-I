+class CustomGINEConv(MessagePassing):
+    """GINE layer that projects the central node features and the aggregated
+    messages to a common dimension before combining them.
+
+    Messages are built from [x_j || edge_attr] when edge attributes are present,
+    and scaled by edge_weight so the explainer can soft-mask edges.
+    """
+
+    def __init__(self, network: nn.Module, in_channels: int, out_channels: int,
+                 eps: float = 0., train_eps: bool = False, **kwargs):
+        super().__init__(aggr='add', **kwargs)
+        self.nn = network
+        self.in_channels = in_channels
+        self.out_channels = out_channels
+
+        # Projects the central node's features to out_channels.
+        self.lin = nn.Linear(in_channels, out_channels)
+
+        self.initial_eps = eps
+        if train_eps:
+            self.eps = torch.nn.Parameter(torch.Tensor([eps]))
+        else:
+            self.register_buffer('eps', torch.Tensor([eps]))
+
+    def forward(self, x: torch.Tensor, edge_index: torch.Tensor,
+                edge_attr: Optional[torch.Tensor] = None,
+                edge_weight: Optional[torch.Tensor] = None) -> torch.Tensor:
+        x_proj = self.lin(x)
+        aggr_out = self.propagate(edge_index, x=x, edge_attr=edge_attr,
+                                  edge_weight=edge_weight)
+        return (1 + self.eps) * x_proj + aggr_out
+
+    def message(self, x_j: torch.Tensor, edge_attr: Optional[torch.Tensor],
+                edge_weight: Optional[torch.Tensor]) -> torch.Tensor:
+        msg_input = x_j
+        if edge_attr is not None:
+            msg_input = torch.cat([x_j, edge_attr], dim=1)
+
+        msg = self.nn(msg_input)
+
+        if edge_weight is not None:
+            msg = msg * edge_weight.view(-1, 1)
+
+        return msg
+
+
+class GINENet_G(nn.Module):
+    """Graph-level GINE oracle (COMBINEX/UCExplainer paper architecture).
+
+    Layer 0 is a CustomGINEConv consuming edge attributes; the remaining layers
+    are GCNConv. Pooling is global_add_pool, matching the reference code.
+
+    edge_attr_dim=0 (e.g. NCI1, which carries no bond types) drops the
+    edge-feature concatenation, so one class serves every dataset — the paper's
+    default is `model: gine` for all of them.
+    """
+
+    def __init__(self, num_features: int, num_classes: int, cfg,
+                 edge_attr_dim: int = 0):
+        super(GINENet_G, self).__init__()
+        self.layers = nn.ModuleList()
+        self.dropout = cfg.model.dropout
+        self.edge_attr_dim = int(edge_attr_dim)
+        hidden = cfg.model.hidden_layers
+
+        # Messages are built from [x_j || edge_attr], so the MLP input widens
+        # by edge_attr_dim.
+        mlp_input_dim = num_features + max(self.edge_attr_dim, 0)
+        message_mlp = nn.Sequential(
+            nn.Linear(mlp_input_dim, hidden[0]),
+            nn.ReLU(),
+            nn.Linear(hidden[0], hidden[0]),
+        )
+        self.layers.append(CustomGINEConv(
+            network=message_mlp,
+            in_channels=num_features,
+            out_channels=hidden[0],
+        ))
+
+        for i in range(1, len(hidden)):
+            self.layers.append(GCNConv(hidden[i - 1], hidden[i]))
+
+        self.output_layer = nn.Linear(hidden[-1], num_classes)
+
+    def _propagate(self, x: torch.Tensor, edge_index: torch.Tensor,
+                   edge_attr: Optional[torch.Tensor] = None,
+                   edge_weights: Optional[torch.Tensor] = None) -> torch.Tensor:
+        # edge_attr is only consumed by the GINE layer; the GCNConv layers take
+        # the (soft) edge weights so the explainer's mask stays differentiable
+        # all the way through.
+        for layer in self.layers:
+            if isinstance(layer, CustomGINEConv):
+                x = layer(x, edge_index, edge_attr=edge_attr, edge_weight=edge_weights)
+            elif edge_weights is not None:
+                x = layer(x, edge_index, edge_weight=edge_weights)
+            else:
+                x = layer(x, edge_index)
+            x = F.relu(x)
+            x = F.dropout(x, self.dropout, training=self.training)
+        return x
+
+    def forward(self, x: torch.Tensor, edge_index: torch.Tensor, batch: torch.Tensor,
+                edge_attr: Optional[torch.Tensor] = None,
+                edge_weights: Optional[torch.Tensor] = None) -> torch.Tensor:
+        x = self._propagate(x, edge_index, edge_attr, edge_weights)
+        x = global_add_pool(x, batch)
+        x = self.output_layer(x)
+        return F.log_softmax(x, dim=1)
+
+    def get_embedding_repr(self, x: torch.Tensor, edge_index: torch.Tensor,
+                           batch: torch.Tensor,
+                           edge_attr: Optional[torch.Tensor] = None,
+                           edge_weights: Optional[torch.Tensor] = None) -> torch.Tensor:
+        """Get the graph-level embedding representation (pre-classifier)."""
+        x = self._propagate(x, edge_index, edge_attr, edge_weights)
+        return global_add_pool(x, batch)
