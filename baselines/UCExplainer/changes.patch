+    (compatible with the AIDS-G / PROTEINS-G branches above).
+    """
+    from src.datasets.gdce_csv_dataset import GDCECsvGraphDataset
+
+    # NCI1-G -> "nci1" (freq: Huang atom-freq>50 filter, 10 atom types) for the
+    # paper's NCI1 comparison. Was "nci1_nofreq" (37 types) previously.
+    name_to_gdce = {"MUTAG-G": "mutagenicity_mol", "NCI1-G": "nci1",
+                    "BENZENE-G": "benzene",
+                    # Non-molecular shared-judge datasets (binary adjacency,
+                    # num_edge_types == 0 — same shape as NCI1-G).
+                    "PROTEINS-GDCE": "proteins", "TWITTER-G": "twitter"}
+    gdce_name = name_to_gdce[dataset_name]
+
+    default_root = "<GDCE_DATA>"
+    data_root = os.environ.get("COMBINEX_GDCE_DATA_ROOT", default_root)
+    root = os.path.join(data_root, gdce_name)
